#define FBS_SLM_merge (16)

static inline void fbs_merge(uint fb_g0, uint fb_g1, uint fb_g2, local uchar *fb_slm, uint *fb_nbp,
    global const float *part_o, global const float2 *part_ml, global const ushort *sink, global const ushort *gate,
                               global const int *rpos, global ushort *out, uint heads, uint window, uint chunk, uint c0, uint chunks,
                               uint subs) {
  const uint rh = get_group_id(0), d = get_local_id(0), row = rh / heads, pos = (uint)rpos[row];
  const uint lo = window && pos + 1 > window ? pos + 1 - window : 0;
  float mm = -INFINITY, ll = 0.0f, o = 0.0f;
  for (uint c = lo / chunk; c <= pos / chunk; ++c) {
    float cm, cl, co;
    if (subs > 1) {
      float sm = -INFINITY, sl = 0.0f, so = 0.0f;
      const uint last = min(subs - 1, (pos - c * chunk) / 1024);
      for (uint u = 0; u <= last; ++u) {
        const size_t at = (size_t)rh * chunks + (c - c0) * subs + u;
        const float2 ml = part_ml[at];
        const float mn = fmax(sm, ml.x);
        const float x = exp2(sm - mn), y = exp2(ml.x - mn);
        sl = sl * x + ml.y * y;
        so = so * x + part_o[at * D + d] * y;
        sm = mn;
      }
      cm = sm; cl = sl; co = so;
    } else {
      const size_t at = (size_t)rh * chunks + c - (window ? lo / chunk : c0);
      const float2 ml = part_ml[at];
      cm = ml.x; cl = ml.y; co = part_o[at * D + d];
    }
    const float mn = fmax(mm, cm), x = exp2(mm - mn), y = exp2(cm - mn);
    ll = ll * x + cl * y;
    o = o * x + co * y;
    mm = mn;
  }
#if INK2_CTL == 5
  const float sk = -INFINITY;
#else
  const float sk = bf2f(sink[rh]) * LOG2E;
#endif
  const float mf = fmax(mm, sk), a0 = exp2(mm - mf);
  const float y = o * a0 / (ll * a0 + exp2(sk - mf));
  const float gv = bf2f(gate[(size_t)rh * D + d]);
  out[(size_t)rh * D + d] = f2bf(y * (1.0f / (1.0f + exp(-gv))));
}

#undef FB_L
#define FB_L 256u
#define FBS_SLM_router_norm_gemv (FB_AL(sizeof(float) * (16)) + FB_AL(sizeof(ushort) * (H)))

static inline void fbs_router_norm_gemv(uint fb_g0, uint fb_g1, uint fb_g2, local uchar *fb_slm, uint *fb_nbp,
    global const float *x, global const ushort *nw, global const ushort *weight, global ushort *normed_out,
    global float *scores, uint rows) {
  const uint row = get_group_id(1), lane = get_sub_group_local_id(), sg = get_sub_group_id(), t = get_local_id(0);
  if (row >= rows) return;
  local float *red = (local float *)(fb_slm + 0);
  local ushort *normed = (local ushort *)(fb_slm + FB_AL(sizeof(float) * (16)));
  global const float *xr = x + (size_t)row * H;
  float sum = 0.0f;
  for (uint d = t; d < H; d += 256) sum = fma(xr[d], xr[d], sum);
  const float s = sub_group_reduce_add(sum);
  if (lane == 0) red[sg] = s;
  FB_BAR(CLK_LOCAL_MEM_FENCE);
  float total = 0.0f;
  for (uint i = 0; i < 16; ++i) total += red[i];
  const float inverse = FUSE_NORM / sqrt(total / (float)H + EPS);
  for (uint d = t; d < H; d += 256) normed[d] = f2bf(bf2f(nw[d]) * (xr[d] * inverse));
  FB_BAR(CLK_LOCAL_MEM_FENCE);
  if (get_group_id(0) == 0) {
    for (uint d = t; d < H; d += 256) normed_out[(size_t)row * H + d] = normed[d];
  }
  const uint expert = get_group_id(0) * 16 + sg;
  if (expert >= 128) return;
  global const uint4 *w = (global const uint4 *)(weight + (size_t)expert * H);
  float dot = 0.0f;
  for (uint part = 0; part < 2; ++part) {
    for (uint u = 0; u < 9; ++u) {
      const uint at = (part * 9 + u) * 16 + lane;
      const uint4 a = w[(part * 9 + u) * 16 + lane];
      const float4 b0 = rx4u(normed, 2 * at), b1 = rx4u(normed, 2 * at + 1);
      dot += as_float(a.x << 16) * b0.x;
      dot += as_float(a.x & 0xffff0000u) * b0.y;
      dot += as_float(a.y << 16) * b0.z;
      dot += as_float(a.y & 0xffff0000u) * b0.w;
      dot += as_float(a.z << 16) * b1.x;
      dot += as_float(a.z & 0xffff0000u) * b1.y;
      dot += as_float(a.w << 16) * b1.z;
      dot += as_float(a.w & 0xffff0000u) * b1.w;
    }
  }
  dot = sub_group_reduce_add(dot);
  if (lane == 0) scores[(size_t)row * 128 + expert] = rsig(dot);
}

#undef FB_L
#define FB_L 128u
#define FBS_SLM_router_pick (FB_AL(sizeof(float) * (128)) + FB_AL(sizeof(float) * (128)) + FB_AL(sizeof(float) * (8)) + FB_AL(sizeof(uint) * (128)) + FB_AL(sizeof(uint) * (8)))

static inline void fbs_router_pick(uint fb_g0, uint fb_g1, uint fb_g2, local uchar *fb_slm, uint *fb_nbp,
    global const float *scores_in, global const float *bias, global uint *ids, global float *weights, uint rows) {
  const uint row = get_group_id(0), t = get_local_id(0);
  if (row >= rows) return;
  local float *keys = (local float *)(fb_slm + 0);
  local float *scores = (local float *)(fb_slm + FB_AL(sizeof(float) * (128)));
  local float *chosen = (local float *)(fb_slm + FB_AL(sizeof(float) * (128)) + FB_AL(sizeof(float) * (128)));
  local uint *flag = (local uint *)(fb_slm + FB_AL(sizeof(float) * (128)) + FB_AL(sizeof(float) * (128)) + FB_AL(sizeof(float) * (8)));
  local uint *picked = (local uint *)(fb_slm + FB_AL(sizeof(float) * (128)) + FB_AL(sizeof(float) * (128)) + FB_AL(sizeof(float) * (8)) + FB_AL(sizeof(uint) * (128)));
  const float sc = scores_in[(size_t)row * 128 + t];
  scores[t] = sc;
  keys[t] = sc + bias[t];
  FB_BAR(CLK_LOCAL_MEM_FENCE);
  const float ke = keys[t];
  uint rank = 0;
  for (uint j = 0; j < 128; ++j) {
    const float kj = keys[j];
    rank += (kj > ke || (kj == ke && j < t)) ? 1u : 0u;
  }
  flag[t] = rank < 8 ? 1u : 0u;
  FB_BAR(CLK_LOCAL_MEM_FENCE);
  if (flag[t]) {
    uint at = 0;
    for (uint j = 0; j < t; ++j) at += flag[j];
    picked[at] = t;
    chosen[at] = scores[t];
  }
  FB_BAR(CLK_LOCAL_MEM_FENCE);
  if (t == 0) {
    float den = 1e-20f;
    for (uint j = 0; j < 8; ++j) den += chosen[j];
    for (uint j = 0; j < 8; ++j) {
      ids[(size_t)row * 8 + j] = picked[j];
      weights[(size_t)row * 8 + j] = chosen[j] / den * 8.0f;
    }
  }
}

#undef FB_L
#define FB_L 256u
#define FBS_SLM_down_epilogue (FB_AL(sizeof(uint) * (8)))

static inline void fbs_down_epilogue(uint fb_g0, uint fb_g1, uint fb_g2, local uchar *fb_slm, uint *fb_nbp,
    global const ushort *down, global const int *ids, global const float *weights,
    global const ushort *history, global ushort *taps, global const ushort *conv_w, global ushort *current,
    global ushort *conv_out, global const float *partial, global ushort *p, uint n, uint topk, uint channels, uint rows, uint commit1) {
  const uint c = get_group_id(0) * 256 + get_local_id(0), t = get_local_id(0);
  local uint *order = (local uint *)(fb_slm + 0);
  for (uint r = 0; r < rows; ++r) {
    global const int *id_row = ids + (size_t)r * topk;
    global const float *w_row = weights + (size_t)r * topk;
    // One thread a slot works out where its slot sits in the expert order the serial selection gives, so every
    // channel reads the order from SLM instead of replaying the scan over global memory.
    if (t < topk && t < 8) {
      const int me = id_row[t];
      uint rank = 0;
      for (uint s = 0; s < 8; ++s) {
        if (s >= topk) break;
        const int id = id_row[s];
        rank += (id < me || (id == me && s < t)) ? 1u : 0u;
      }
      order[rank] = t;
    }
    FB_BAR(CLK_LOCAL_MEM_FENCE);
    if (c < n && c < channels) {
      float sum = 0.0f;
      for (uint k = 0; k < 8; ++k) {
        if (k >= topk) break;
        const uint slot = order[k];
        sum += w_row[slot] * bf2f(down[((size_t)r * topk + slot) * n + c]);
      }
      const ushort y = f2bf(sum);
      current[(size_t)r * channels + c] = y;
      const ushort cy = conv_y(history, current, taps, conv_w, r, c, channels);
      conv_out[(size_t)r * channels + c] = cy;
      const uint at = r * channels + c;
      p[at] = FUSE_EPI ? f2bf(partial[at] + bf2f(cy)) : (ushort)0;
    }
    FB_BAR(CLK_LOCAL_MEM_FENCE);
  }
  if (commit1 && rows == 1 && c < n && c < channels) commit3(history, current, c, channels);
}

#undef get_group_id
#undef get_local_id
#undef get_sub_group_id
#undef FB_L


// fuse_pre_q: today tf_ink2_fuse_pre_q, 256 work-items, grid (3, 1, 1), 3 tasks; 2 slots a group, layout dist.
FB_SGA kernel void fbr_fuse_pre_q(global const ushort *p, global float *partial, global const ushort *blocks, global const float *queries, global float *ar,
    global const ushort *wq, global const ushort *wk, global const ushort *wv,
    global ushort *q_norm, global ushort *k_norm, global ushort *v_norm,
    uint rows, uint blocks_stride, uint sources, uint n_queries, uint norm_n,
    global uint *fb_sync, global uint *fb_fault, uint fb_reps, uint fb_mech, uint fb_cap) {
  local uchar fb_slm[2 * FBS_SLM_fuse_pre_q];
  local uint fb_lf;
  local uint fb_ann[2 * 2];
  const uint slot = get_local_id(0) / 256u;
  const bool fb_lead = get_local_id(0) % 256u == 0u;
  if (fb_lead) {
    fb_ann[slot] = 0u;
    fb_ann[2u + slot] = 0u;
  }
  uint fb_epoch = 0u;
  fb_enter(fb_mech, fb_sync);
  for (uint r = 0u; r < fb_reps; ++r) {
    FB_STAMP_AT(0)
    for (uint base = get_group_id(0) * 2u; base < 3u; base += get_num_groups(0) * 2u) {
      const uint task = base + slot;
      uint fb_nb = 0u;
      ++fb_epoch;
      if (task < 3u)
        fbs_fuse_pre_q(task % 3u, (task / 3u) % 1u, task / 3u, fb_slm + slot * FBS_SLM_fuse_pre_q, &fb_nb,
            p, partial, blocks, queries, ar, wq, wk, wv, q_norm, k_norm, v_norm, rows, blocks_stride, sources, n_queries, norm_n);
      fb_pad(fb_ann, slot, 2u, fb_epoch, fb_nb, fb_lead);
    }
    FB_STAMP_AT(1)
    fb_arrive(fb_mech, fb_sync, r + 1u);
    if (fb_wait(fb_mech, fb_sync, fb_fault, r + 1u, fb_cap, &fb_lf) != 0u) {
      return;
    }
    FB_STAMP_AT(2)
  }
}


