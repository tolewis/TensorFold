}

static inline float rsig(float x) {
  const float e = exp(-fabs(x));
  return x < 0.0f ? e / (1.0f + e) : 1.0f / (1.0f + e);
}

static inline float4 rx4u(local const ushort *n, uint i) {
  const uint b = i * 4;
