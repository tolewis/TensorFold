#undef FB_L
#define FB_L 64u
#define FBS_SLM_fuse_gates (FB_AL(sizeof(float) * (RANK)))

static inline void fbs_fuse_gates(uint fb_g0, uint fb_g1, uint fb_g2, local uchar *fb_slm, uint *fb_nbp,
    global const float *ar, global const float *messages, global const ushort *forget0, global const ushort *forget1,
    global const ushort *forget2, global const ushort *gain0, global const ushort *gain1, global const ushort *gain2,
    global const float *zeta, global float *gated, uint rows, uint roles, uint local_src, uint core, uint msg_entries) {
  const uint role = get_group_id(1), row = get_group_id(2), t = get_local_id(0);
  const uint d = get_group_id(0) * 64 + t;
  if (row >= rows || role >= roles || d >= H) return;
  local float *z = (local float *)(fb_slm + 0);
  z[t] = zeta[((size_t)row * 4 + role) * RANK + t];
  const uint src = local_src ? 0 : role;
  global const float *h = ar + ((size_t)src * rows + row) * H;
  global const float *m = messages + ((size_t)row * msg_entries + core * 4 + role) * H;
  global const ushort *forget = role == 0 ? forget0 : role == 1 ? forget1 : forget2;
  global const ushort *gain = role == 0 ? gain0 : role == 1 ? gain1 : gain2;
  ushort8 fw[RANK / 8], gw[RANK / 8];
  for (uint r = 0; r < RANK / 8; ++r) {
    fw[r] = vload8(0, forget + (size_t)d * RANK + 8 * r);
    gw[r] = vload8(0, gain + (size_t)d * RANK + 8 * r);
  }
  FB_BAR(CLK_LOCAL_MEM_FENCE);
  float fdot = 0.0f, gdot = 0.0f;
  for (uint r = 0; r < RANK / 8; ++r)
    for (int j = 0; j < 8; ++j) {
      fdot += bf2f(fw[r][j]) * z[8 * r + j];
      gdot += bf2f(gw[r][j]) * z[8 * r + j];
    }
  const float f = tanh(fdot);
  const float g = tanh(gdot);
  const float keep = 1.0f - f;
  const float left = keep * h[d];
  const float right = FUSE_GATE * g * m[d];
  gated[((size_t)role * rows + row) * H + d] = left + right;
}

#undef FB_L
#define FB_L 256u
#define FBS_SLM_fuse_norms (FB_AL(sizeof(float) * (16)))

static inline void fbs_fuse_norms(uint fb_g0, uint fb_g1, uint fb_g2, local uchar *fb_slm, uint *fb_nbp,
    global const float *gated, global const ushort *wq, global const ushort *wk, global const ushort *wv,
    global ushort *q_norm, global ushort *k_norm, global ushort *v_norm, uint rows, uint norm_n) {
  const uint which = get_group_id(0), row = get_group_id(1), t = get_local_id(0);
  if (row >= rows || which >= norm_n) return;
  local float *red = (local float *)(fb_slm + 0);
  global const float *x = gated + ((size_t)which * rows + row) * H;
  global const ushort *w = which == 0 ? wq : which == 1 ? wk : wv;
  global ushort *out = (which == 0 ? q_norm : which == 1 ? k_norm : v_norm) + (size_t)row * H;
  do_norm(x, w, out, t, red, fb_nbp);
}

#undef FB_L
#define FB_L 256u
#define FBS_SLM_conv_dynamic (FB_AL(sizeof(float) * (32)) + FB_AL(sizeof(float4) * (INK_HIDDEN / 4)))

static inline void fbs_conv_dynamic(uint fb_g0, uint fb_g1, uint fb_g2, local uchar *fb_slm, uint *fb_nbp,
    global const ushort *history, global const ushort *current, global ushort *taps,
                                          global const ushort *input, global const ushort *static_w, global const ushort *projection,
                                          global ushort *out, uint rows, uint channels) {
  const uint r = get_group_id(0), t = get_local_id(0);
  if (r >= rows) return;
  local float *projected = (local float *)(fb_slm + 0);
  local float4 *xs = (local float4 *)(fb_slm + FB_AL(sizeof(float) * (32)));
  global const uint2 *xg = (global const uint2 *)(input + (ulong)r * INK_HIDDEN);
  for (uint i = t; i < INK_HIDDEN / 4; i += 256) {
    const uint2 v = xg[i];
    xs[i] = (float4)(as_float(v.x << 16), as_float(v.x & 0xffff0000u), as_float(v.y << 16), as_float(v.y & 0xffff0000u));
  }
  FB_BAR(CLK_LOCAL_MEM_FENCE);
  if (t < 32) {
    // One work-item adds one projected value's products in order d = 0 to 2303, each product rounded, then added.
    global const uint4 *w = (global const uint4 *)(projection + (ulong)t * INK_HIDDEN);
    float dot = 0.0f;
    for (uint i = 0; i < INK_HIDDEN / 8; i += 4) {
      uint4 a[4];
      for (uint u = 0; u < 4; ++u) a[u] = w[i + u];
      for (uint u = 0; u < 4; ++u) {
        const float4 b0 = xs[2 * (i + u)], b1 = xs[2 * (i + u) + 1];
        dot += as_float(a[u].x << 16) * b0.x;
        dot += as_float(a[u].x & 0xffff0000u) * b0.y;
        dot += as_float(a[u].y << 16) * b0.z;
        dot += as_float(a[u].y & 0xffff0000u) * b0.w;
        dot += as_float(a[u].z << 16) * b1.x;
        dot += as_float(a[u].z & 0xffff0000u) * b1.y;
        dot += as_float(a[u].w << 16) * b1.z;
        dot += as_float(a[u].w & 0xffff0000u) * b1.w;
      }
    }
    projected[t] = bf2f(f2bf(dot));
  }
  FB_BAR(CLK_LOCAL_MEM_FENCE);
  for (uint c = t; c < channels; c += 256) {
    float window[4]; // window[j] is the row r + 3 - j of the history-then-current rows
    for (uint lag = 0; lag < 4; ++lag) {
      const uint k = r + 3 - lag;
      window[lag] = bf2f(k < 3 ? history[(ulong)k * channels + c] : current[(ulong)(k - 3) * channels + c]);
    }
    if (r == 0)
      for (uint k = 0; k < 3; ++k) taps[(ulong)k * channels + c] = history[(ulong)k * channels + c];
    taps[(ulong)(r + 3) * channels + c] = current[(ulong)r * channels + c];
    float sum = bf2f(current[(ulong)r * channels + c]);
    for (uint lag = 0; lag < 4; ++lag) {
      const float w = bf2f(static_w[lag * channels + c]) + projected[4 * (c / 128) + lag];
      sum += w * window[lag];
    }
    out[(ulong)r * channels + c] = f2bf(sum / 3.0f);
  }
}

