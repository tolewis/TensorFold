  }
}


// router_pick: today tf_ink2_router_pick, 128 work-items, grid (1, 1, 1), 1 tasks; 4 slots a group, layout dist.
FB_SGA kernel void fbr_router_pick(global const float *scores_in, global const float *bias, global uint *ids, global float *weights, uint rows,
    global uint *fb_sync, global uint *fb_fault, uint fb_reps, uint fb_mech, uint fb_cap) {
  local uchar fb_slm[4 * FBS_SLM_router_pick];
  local uint fb_lf;
  local uint fb_ann[2 * 4];
  const uint slot = get_local_id(0) / 128u;
  const bool fb_lead = get_local_id(0) % 128u == 0u;
  if (fb_lead) {
    fb_ann[slot] = 0u;
    fb_ann[4u + slot] = 0u;
  }
  uint fb_epoch = 0u;
  fb_enter(fb_mech, fb_sync);
  for (uint r = 0u; r < fb_reps; ++r) {
    FB_STAMP_AT(0)
    for (uint base = get_group_id(0) * 4u; base < 1u; base += get_num_groups(0) * 4u) {
      const uint task = base + slot;
      uint fb_nb = 0u;
      ++fb_epoch;
      if (task < 1u)
        fbs_router_pick(task % 1u, (task / 1u) % 1u, task / 1u, fb_slm + slot * FBS_SLM_router_pick, &fb_nb,
            scores_in, bias, ids, weights, rows);
      fb_pad(fb_ann, slot, 4u, fb_epoch, fb_nb, fb_lead);
    }
    FB_STAMP_AT(1)
    fb_arrive(fb_mech, fb_sync, r + 1u);
    if (fb_wait(fb_mech, fb_sync, fb_fault, r + 1u, fb_cap, &fb_lf) != 0u) {
      return;
    }
    FB_STAMP_AT(2)
  }
}


// down_epilogue: today tf_ink2_down_epilogue, 256 work-items, grid (9, 1, 1), 9 tasks; 2 slots a group, layout dist.
FB_SGA kernel void fbr_down_epilogue(global const ushort *down, global const int *ids, global const float *weights,
    global const ushort *history, global ushort *taps, global const ushort *conv_w, global ushort *current,
    global ushort *conv_out, global const float *partial, global ushort *p, uint n, uint topk, uint channels, uint rows, uint commit1,
    global uint *fb_sync, global uint *fb_fault, uint fb_reps, uint fb_mech, uint fb_cap) {
  local uchar fb_slm[2 * FBS_SLM_down_epilogue];
  local uint fb_lf;
  local uint fb_ann[2 * 2];
  const uint slot = get_local_id(0) / 256u;
  const bool fb_lead = get_local_id(0) % 256u == 0u;
  if (fb_lead) {
    fb_ann[slot] = 0u;
    fb_ann[2u + slot] = 0u;
  }
  uint fb_epoch = 0u;
  fb_enter(fb_mech, fb_sync);
  for (uint r = 0u; r < fb_reps; ++r) {
    FB_STAMP_AT(0)
    for (uint base = get_group_id(0) * 2u; base < 9u; base += get_num_groups(0) * 2u) {
      const uint task = base + slot;
      uint fb_nb = 0u;
      ++fb_epoch;
      if (task < 9u)
        fbs_down_epilogue(task % 9u, (task / 9u) % 1u, task / 9u, fb_slm + slot * FBS_SLM_down_epilogue, &fb_nb,
            down, ids, weights, history, taps, conv_w, current, conv_out, partial, p, n, topk, channels, rows, commit1);
      fb_pad(fb_ann, slot, 2u, fb_epoch, fb_nb, fb_lead);
    }
    FB_STAMP_AT(1)
    fb_arrive(fb_mech, fb_sync, r + 1u);
    if (fb_wait(fb_mech, fb_sync, fb_fault, r + 1u, fb_cap, &fb_lf) != 0u) {
      return;
    }
    FB_STAMP_AT(2)
  }
}
